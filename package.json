{
  "name": "iobroker.mihome-vacuum",
  "version": "5.5.0",
  "description": "Control your mihome vacuum cleaner with ioBroker",
  "keywords": [
    "ioBroker",
    "mihome-vacuum"
  ],
  "homepage": "https://github.com/iobroker-community-adapters/ioBroker.mihome-vacuum",
  "bugs": {
    "url": "https://github.com/iobroker-community-adapters/ioBroker.mihome-vacuum/issues"
  },
  "license": "MIT",
  "author": "bluefox <dogafox@gmail.com>",
  "contributors": [
    "iobroker-community-adapters <iobroker-community-adapters@gmx.de>"
  ],
  "main": "build/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/iobroker-community-adapters/ioBroker.mihome-vacuum"
  },
  "scripts": {
    "prebuild": "rimraf build",
    "build": "build-adapter ts",
    "watch": "build-adapter ts --watch",
    "prebuild:ts": "rimraf build",
    "build:ts": "build-adapter ts",
    "watch:ts": "build-adapter ts --watch",
    "test:package": "mocha test/package --exit",
    "test:unit": "mocha test/unit --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:package",
    "check": "tsc --noEmit -p tsconfig.check.json",
    "lint": "eslint -c eslint.config.mjs .",
    "translate": "gulp translateAndUpdateWordsJS",
    "release": "release-script",
    "test:ts": "mocha --config test/mocha.custom.json \"src/**/*.test.ts\""
  },
  "files": [
    "admin{,/!(src)/**}/!(tsconfig|tsconfig.*|.eslintrc).{json,json5}",
    "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
    "build/",
    "www/",
    "io-package.json",
    "LICENSE"
  ],
  "optionalDependencies": {
    "canvas": "^3.1.2"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "axios": "^1.19.0",
    "axios-cookiejar-support": "^7.0.0",
    "qs": "^6.14.2",
    "tough-cookie": "^6.0.2"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.0",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^5.3.0",
    "@tsconfig/node20": "^20.1.9",
    "@types/chai": "^5.2.2",
    "@types/chai-as-promised": "^8.0.2",
    "@types/gulp": "^4.0.18",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/proxyquire": "^1.3.31",
    "@types/qs": "^6.9.18",
    "@types/sinon": "^17.0.3",
    "@types/sinon-chai": "^4.0.0",
    "chai": "^5.1.2",
    "chai-as-promised": "^8.0.2",
    "gulp": "^5.0.1",
    "mocha": "^11.7.6",
    "proxyquire": "^2.1.3",
    "rimraf": "^6.1.3",
    "sinon": "^21.0.0",
    "sinon-chai": "^4.0.1",
    "typescript": "~5.9.3"
  }
}
